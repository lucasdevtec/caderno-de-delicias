datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Difficulty {
  FACIL
  MEDIO
  DIFICIL
}

enum Role {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  username      String?   @unique
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  bio           String?   @db.Text
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  cadernos Caderno[]
  recipes  Recipe[]
  accounts Account[]
  sessions Session[]

  @@index([email])
  @@index([username])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Caderno {
  id          String   @id @default(cuid())
  title       String
  slug        String
  description String?  @db.Text
  coverColor  String?  @default("#EA580C")
  coverImage  String?
  icon        String?  @default("chef-hat")
  isPublic    Boolean  @default(true)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Fork / Attribution: Se este caderno foi copiado de outro caderno público
  originalCadernoId  String?
  originalCaderno    Caderno?  @relation("CadernoForks", fields: [originalCadernoId], references: [id], onDelete: SetNull)
  forks              Caderno[] @relation("CadernoForks")
  originalAuthorName String?
  copiedAt           DateTime?

  recipes   CadernoRecipe[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([userId, slug])
  @@index([userId])
  @@index([isPublic])
  @@index([originalCadernoId])
}

model Recipe {
  id              String     @id @default(cuid())
  title           String
  slug            String
  description     String?    @db.Text
  prepTimeMinutes Int?
  cookTimeMinutes Int?
  servings        Int?       @default(4)
  difficulty      Difficulty @default(FACIL)
  category        String? // Sobremesa, Massas, Pães, Prato Principal, etc.
  coverImage      String?
  isPublic        Boolean    @default(true)
  tips            String?    @db.Text
  viewsCount      Int        @default(0)

  // JSON estruturado de ingredientes e passos
  // ingredients: [{ item: string, quantity: string, unit?: string }]
  ingredients  Json @default("[]")
  // instructions: [{ stepNumber: number, title?: string, description: string }]
  instructions Json @default("[]")

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  cadernos  CadernoRecipe[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([userId, slug])
  @@index([userId])
  @@index([isPublic])
  @@index([category])
  @@index([viewsCount])
}

model CadernoRecipe {
  id        String   @id @default(cuid())
  cadernoId String
  caderno   Caderno  @relation(fields: [cadernoId], references: [id], onDelete: Cascade)
  recipeId  String
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  position  Int      @default(0) // Ordem da receita dentro do caderno (0, 1, 2...)
  addedAt   DateTime @default(now())

  @@unique([cadernoId, recipeId])
  @@index([cadernoId, position])
}
