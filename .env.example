# ==========================================
# 🍳 CADERNO DE DELÍCIAS (cadernodedelicias.com.br)
# Variáveis de Ambiente
# ==========================================

# 🗄️ BANCO DE DADOS (PostgreSQL)
DATABASE_URL="postgresql://caderno:caderno_secret@localhost:5432/caderno_delicias?schema=public"

# 🌐 APLICAÇÃO WEB
NEXT_PUBLIC_APP_URL="http://localhost:3000"
PORT=3000
NODE_ENV="development"

# 🔐 SEGURANÇA E SESSÃO (Gere uma chave aleatória com: openssl rand -base64 32)
AUTH_SECRET="caderno-de-delicias-secret-development-key-change-in-production-2026"

# 🔑 GOOGLE OAUTH (Opcional - Obtenha em https://console.cloud.google.com)
# Crie credenciais do tipo OAuth 2.0 Client ID (Web Application)
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# 💖 DOAÇÕES (Chave Pix para apoiar o projeto)
NEXT_PUBLIC_PIX_KEY="782b5623-0afa-4035-bbb6-7452045fddf3"

# 📧 E-MAILS & RECUPERAÇÃO DE SENHA (Opcional - https://resend.com)
# Em ambiente de desenvolvimento sem chave configurada, o link de recuperação é exibido no terminal
RESEND_API_KEY=""
EMAIL_FROM="Caderno de Delícias <nao-responda@cadernodedelicias.com.br>"

